# ---- Gemini (free tier) ----------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=10000

# ---- Google Sheets (service account) ---------------------------------------
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Tab name inside that spreadsheet
SHEET_NAME=Log
# From the service account JSON key. Share the sheet with this address (Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value on ONE line, keeping the literal \n sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Behaviour -------------------------------------------------------------
TZ=Asia/Tokyo
DEFAULT_CURRENCY=JPY
LOCALE=en-US

# Extra chats allowed to drive the bot, comma separated. Empty = self-chat only.
# Only messages you sent yourself are ever accepted, in any chat.
ALLOWED_CHAT_JIDS=

# How often to retry writes that failed and got queued (ms)
QUEUE_FLUSH_MS=60000

# Set to "info" or "debug" to see Baileys internals
BAILEYS_LOG_LEVEL=silent

# ---- Bridge <-> brain ------------------------------------------------------
# The Python service listens here; the Node bridge posts to it.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
BRAIN_URL=http://127.0.0.1:8000
BRAIN_TIMEOUT_MS=20000

# Shared secret so only the bridge can post messages. Generate with:
#   openssl rand -hex 24
BRIDGE_TOKEN=

# Where Baileys keeps its session so you do not re-scan the QR on every restart
AUTH_DIR=./auth
